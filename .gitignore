.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.DS_Store
out/

# Everything under data/ is local and never committed: captures, per-unit
# reference measurements, other organisations' published files, working PSDs,
# and the READMEs describing them. A capture is the operator's own or its
# publisher's, a CGATS header carries an instrument's serial, and none of it is
# this project's to distribute. Tests needing any of it skip when it is absent.
data/

# The exported copy workbook. Generated by tools/export_copy.py, binary, and
# the whole point of it is that it is regenerated whenever the prose has moved.
deltachrome-copy.xlsx
deltachrome-copy.csv
deltachrome-proposals.json

# Packaging environments: the release build's and any made to test one.
packaging/.venv*/
