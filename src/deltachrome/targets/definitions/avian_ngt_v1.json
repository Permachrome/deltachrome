  "reference_data": {
    "source_type": "per_unit_file",
    "import_format": "cgats",
    "required": true,
    "nominal_values": {
      "file": "avian_ngt_v1_nominal.txt",
      "basis": "manufacturer_nominal",
      "source": "OpenDICE's profile for this target, converted by tools/generate_opendice_nominal.py. The specimen it was published beside carries serial AR-NGT-2016023.",
      "covers": "All 130 patches, L*a*b*, plus density on the twelve ramp steps.",
      "notes": "Batch averages rather than design aims -- the values quantize to 0.002, which is a mean of five readings each to two decimals, not a number anyone chose. Closer to any individual chart than an aim would be, and still not a measurement of the chart in front of you. Avian Rochester measure and ship data with each target; that file supersedes this one and a run against it can carry a conformance claim, which a run against this cannot."
    },
    "notes": "A per-unit file is preferred and is used whenever one is supplied. This chart prints its own serial, so the pairing is checkable by eye even though the serial is set in type rather than encoded."
  },
  "dimensional_reference": {
    "available": false,
    "summary": "The chart prints no scale and carries no dimension this project has measured, so sampling frequency cannot be derived from it. Supply --fiducial-extent to state the distance the four placed corners span on your own specimen.",
    "notes": "The OpenDICE sample's own header says 400 ppi, which would make the patch array 175.5 x 135.3 mm. That is not evidence: it is the capture's claim about itself, and checking a capture's stated sampling rate is what a dimensional reference is FOR. Quoting it back would make the test circular."
  },
  "metric_defaults": {
    "tonal_response": {
      "uses_patches": [
        "achromatic_ramp"
      ],
      "notes": "Twelve steps, printed as two rows of six running in OPPOSITE directions -- row 2 darkest-first from D to I, row 6 lightest-first -- so reading them in position order interleaves the ladder. The order here is by the density OpenDICE states for each step, which is the quantity the ladder is built on. Both charts give the same order, which is the check that it is a property of the design and not of one batch's measurements."
    },
    "white_balance": {
      "uses_patches": [
        "achromatic_ramp"
      ],
      "notes": "Delta E(a*b*) against a neutral aim, L* excluded."
    },
    "lightness_uniformity": {
      "uses_patches": [
        "achromatic_border"
      ],
      "notes": "Resolved at runtime from repeated neutrals in the reference data rather than hand-listed here, because which patches repeat is a fact about the reference file and hand-listing it would freeze one batch's answer into the definition. On the shipped nominal values it resolves to two families: eight near-whites at A0, A4, A9, G0, G9, M0, M4/M5 and M9 -- which sit at the corners, the mid-edges and the centre column, so they genuinely span the chart's area -- and four mid-greys at A5, F9, H0 and M4/M5. The two charts disagree about whether M4 or M5 carries the grey, which is why neither is written down here."
    }
  },
  "notes": "GEOMETRY MEASURED FROM ONE CAPTURE. Thirteen columns A-M by ten rows 0-9, 130 patches, on a matte black mount that prints the column letters and row digits beside them, so the patch ids in a reference file can be checked against the chart by eye. The array is all this chart carries: no slanted edges, no printed rules, no frame-filling white. The DT Next Generation Target V2 shares this lattice exactly and is a separate definition, because its patches are printed to different values and the two reference files are not interchangeable. The geometry rests on one sample capture of one unit."
